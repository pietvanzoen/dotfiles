# Ghostty config — solarized dark (P3-adjusted values from iTerm2 Default profile)

# ── Font ─────────────────────────────────────────────────────────────
font-family = Maple Mono NF
font-size = 16

# ── Colors ───────────────────────────────────────────────────────────
background = #002b36
foreground = #839496
cursor-color = #839496
cursor-text  = #073642
selection-background = #073642
selection-foreground = #93a1a1

# ANSI palette (solarized dark, P3-adjusted)
palette = 0=#163540
palette = 1=#dc322f
palette = 2=#859900
palette = 3=#b58900
palette = 4=#268bd2
palette = 5=#d33682
palette = 6=#2aa198
palette = 7=#eee8d5
palette = 8=#274351
palette = 9=#cb4b16
palette = 10=#586e75
palette = 11=#657b83
palette = 12=#839496
palette = 13=#6c71c4
palette = 14=#93a1a1
palette = 15=#fdf6e3

# ── Window ───────────────────────────────────────────────────────────
window-padding-x = 6
window-padding-y = 4
macos-titlebar-style = hidden

# ── Behaviour ────────────────────────────────────────────────────────
macos-option-as-alt = left
scrollback-limit = 10000
confirm-close-surface = false
auto-update = download

# ── Shell ────────────────────────────────────────────────────────────
shell-integration = zsh

# ── Keybindings ──────────────────────────────────────────────────────
# Pass Ctrl+Tab / Shift+Ctrl+Tab through to tmux for window navigation
# tmux: C-Tab=next-window, User0(\e[1;6Z)=previous-window
keybind = ctrl+tab=unbind
keybind = ctrl+tab=text:\x1b[1;5I
keybind = shift+ctrl+tab=text:\x1b[1;6Z
