{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "USE_BUILTIN_RIPGREP": "0",
    "FORCE_COLOR": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Bash(npm run :*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(mkdir:*)",
      "Bash(sips:*)",
      "Bash(terminal-notifier:*)",
      "Bash(ntfy-notify:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(stow:*)",
      "Bash(readlink:*)",
      "Bash(git config:*)",
      "WebSearch",
      "Bash(gh pr view:*)",
      "Bash(gh run view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh save-me-copilot:*)",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__get_issue_status",
      "Bash(tmux send-keys:*)",
      "Bash(tmux list-panes:*)",
      "Bash(tmux list-windows:*)",
      "Bash(tmux rename-window:*)",
      "Bash(tmux set-window-option:*)",
      "Read(~/.zshrc)",
      "Read(~/.bashrc)",
      "Read(~/.config/**)",
      "Read(package.json)",
      "Read(tsconfig.json)",
      "Read(*.md)",
      "Read(.claude-notes)",
      "Write(.claude-notes)",
      "Edit(.claude-notes)",
      "Bash(claude-notes-update *)",
      "Skill(notes)",
      "mcp__trello__list_boards",
      "mcp__trello__list_workspaces",
      "mcp__trello__get_lists",
      "mcp__trello__get_cards_by_list_id",
      "mcp__trello__get_card",
      "mcp__trello__get_card_comments",
      "mcp__trello__get_card_history",
      "mcp__trello__get_board_labels",
      "mcp__trello__get_board_members",
      "mcp__trello__get_checklist_items",
      "mcp__trello__get_my_cards",
      "mcp__trello__get_recent_activity",
      "mcp__trello__get_active_board_info",
      "mcp__trello__set_active_board",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(slack-api *)",
      "Bash(todo *)",
      "Bash(todo)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env*)",
      "Write(./.env*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/on-user-prompt-submit"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/on-notification 'Needs permission' Purr"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/on-elicitation"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/on-notification 'Waiting for your input' Purr"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/on-stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/piet/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "stripe@claude-plugins-official": true
  }
}
