{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "USE_BUILTIN_RIPGREP": "0",
    "FORCE_COLOR": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git merge:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(git switch:*)",
      "Bash(git tag:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(yarn:*)",
      "Bash(mkdir:*)",
      "Bash(terminal-notifier:*)",
      "Bash(ntfy-notify:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(stow:*)",
      "Bash(readlink:*)",
      "Bash(git config:*)",
      "WebSearch",
      "mcp__linear-server__get_issue",
      "mcp__linear-server__get_issue_status",
      "Bash(nvim-open:*)",
      "Bash(tmux send-keys:*)",
      "Bash(tmux list-panes:*)",
      "Bash(tmux list-windows:*)",
      "Bash(tmux split-window:*)",
      "Bash(tmux rename-window:*)",
      "Bash(tmux set-window-option:*)",
      "Read(~/.zshrc)",
      "Read(~/.bashrc)",
      "Read(~/.config/**)",
      "Read(~/.claude/docs/**)",
      "Read(package.json)",
      "Read(tsconfig.json)",
      "Read(*.md)",
      "Edit(~/.claude/plans/*.md)",
      "Write(~/.claude/plans/*.md)",
      "Skill(commit-commands:commit)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(todo *)",
      "Bash(todo)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(printenv:*)",
      "Bash(printenv)",
      "Bash(env)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env*)",
      "Write(./.env*)"
    ]
  },
  "availableModels": [
    "sonnet",
    "haiku",
    "opus",
    "opusplan"
  ],
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/on-user-prompt-submit"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/on-notification 'Needs permission' Purr"
          }
        ]
      },
      {
        "matcher": "elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/on-elicitation"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/on-notification 'Waiting for your input' Purr"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/on-stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/piet/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "linear@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ast-grep-marketplace": {
      "source": {
        "source": "github",
        "repo": "ast-grep/agent-skill"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "localhost",
        "api.anthropic.com",
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "api.linear.app",
        "api.slack.com",
        "slack.com",
        "*.sentry.io",
        "oauth2.googleapis.com",
        "storage.googleapis.com"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/yarn",
        "~/.local/state"
      ],
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        "~/.local/bin",
        "~/.claude",
        "~/dotfiles",
        "~/.nvm",
        "~/Library/Caches/fnm_multishells",
        "~/Library/Application Support/fnm",
        "~/.gitconfig",
        "~/.config/git",
        "~/.yarnrc",
        "~/.config/yarn",
        "~/.config/gh",
        "~/.npmrc",
        "~/.cache/yarn",
        "~/package.json",
        "~/.local/state"
      ]
    },
    "excludedCommands": [
      "git",
      "git *",
      "gh",
      "gh *"
    ]
  },
  "effortLevel": "medium",
  "showClearContextOnPlanAccept": true,
  "tui": "fullscreen",
  "editorMode": "vim",
  "preferredNotifChannel": "ghostty",
  "skipAutoPermissionPrompt": true
}
