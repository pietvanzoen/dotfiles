#!/usr/bin/env bash
# Hook: Notification (elicitation_dialog)
# - Fires terminal-notifier asking for input
# - Sets @claude-needs-input window option for tmux status indicator

input=$(cat)

set_claude_state() {  # args: thinking needs_input done
  [ -n "$TMUX" ] || return
  tmux set-window-option @claude-thinking "${1}" 2>/dev/null || true
  tmux set-window-option @claude-needs-input "${2}" 2>/dev/null || true
  tmux set-window-option @claude-done "${3}" 2>/dev/null || true
}
set_claude_state 0 1 0

cwd=$(echo "$input" | jq -r '.cwd // ""')
if [ -z "$cwd" ] || [ "$cwd" = "null" ]; then
  cwd=$(pwd)
fi

dir_context=$(basename "$cwd")

terminal-notifier \
  -title "Claude Code - $dir_context" \
  -message "Has a question for you" \
  -sound Purr \
  -contentImage "$HOME/.claude/icons/claude.png"

question=$(echo "$input" | jq -r '.message // ""')
ntfy_msg="${question:-Has a question for you}"
ntfy-notify --away-only --topic claude --tags robot "Claude Code - $dir_context" "$ntfy_msg"

