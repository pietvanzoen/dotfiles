#!/usr/bin/env bash
# Hook: Stop
# - Fires terminal-notifier "Done"

input=$(cat)

set_claude_state() {  # arg: thinking|needs_input|done|idle
  [ -n "$TMUX" ] || return
  tmux set-window-option -u @claude-thinking 2>/dev/null || true
  tmux set-window-option -u @claude-needs-input 2>/dev/null || true
  tmux set-window-option -u @claude-done 2>/dev/null || true
  case "$1" in
    thinking)    tmux set-window-option @claude-thinking 1 2>/dev/null || true ;;
    needs_input) tmux set-window-option @claude-needs-input 1 2>/dev/null || true ;;
    finished)    tmux set-window-option @claude-done 1 2>/dev/null || true ;;
  esac
}
set_claude_state finished

cwd=$(echo "$input" | jq -r '.cwd // ""')
if [ -z "$cwd" ] || [ "$cwd" = "null" ]; then
  cwd=$(pwd)
fi

dir_context=$(basename "$cwd")

# Extract last response for notification
last_msg="Done"
session_id=$(echo "$input" | jq -r '.session_id // ""')
if [ -n "$session_id" ] && [ "$session_id" != "null" ] && [ -n "$cwd" ]; then
  encoded_cwd="${cwd//\//-}"
  jsonl_file="$HOME/.claude/projects/${encoded_cwd}/${session_id}.jsonl"
  if [ -f "$jsonl_file" ]; then
    extracted=$(python3 - "$jsonl_file" <<'PYEOF'
import json, sys
last_text = None
with open(sys.argv[1]) as f:
    for line in f:
        try:
            entry = json.loads(line)
            if entry.get("type") == "assistant":
                content = entry.get("message", {}).get("content", [])
                texts = [b["text"] for b in content if b.get("type") == "text"]
                if texts:
                    last_text = "\n\n".join(texts)
        except Exception:
            continue
if last_text:
    print(last_text[:500].strip(), end="")
PYEOF
    )
    [ -n "$extracted" ] && last_msg="$extracted"
  fi
fi

terminal-notifier \
  -title "$dir_context - Claude Code" \
  -message "Done" \
  -sound Glass \
  -contentImage "$HOME/.claude/icons/claude.png"

ntfy-notify --away-only --topic claude --tags robot "$dir_context - Claude Code" "$last_msg"

# Save last assistant response text for /copy skill
if [ -n "$session_id" ] && [ "$session_id" != "null" ] && [ -n "$cwd" ]; then
  encoded_cwd="${cwd//\//-}"
  jsonl_file="$HOME/.claude/projects/${encoded_cwd}/${session_id}.jsonl"
  if [ -f "$jsonl_file" ]; then
    python3 - "$jsonl_file" > "$HOME/.claude/last-response.txt" <<'PYEOF'
import json, sys
last_text = None
with open(sys.argv[1]) as f:
    for line in f:
        try:
            entry = json.loads(line)
            if entry.get("type") == "assistant":
                content = entry.get("message", {}).get("content", [])
                texts = [b["text"] for b in content if b.get("type") == "text"]
                if texts:
                    last_text = "\n\n".join(texts)
        except Exception:
            continue
if last_text:
    print(last_text, end="")
PYEOF
  fi
fi

# Refresh notes (PR info, mtime) in the background
(cd "$cwd" && claude-notes-update --refresh) >/dev/null 2>&1 &
