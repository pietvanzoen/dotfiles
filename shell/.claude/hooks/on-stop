#!/usr/bin/env bash
# Hook: Stop
# - Fires terminal-notifier "Done"
# - Renames tmux window back to basename (removes ⏺ indicator)

input=$(cat)

cwd=$(echo "$input" | jq -r '.cwd // ""')
if [ -z "$cwd" ] || [ "$cwd" = "null" ]; then
  cwd=$(pwd)
fi

dir_context=$(echo "$cwd" | sed "s|$HOME|~|" | awk -F'/' '{if (NF>=2) print $(NF-1)"/"$NF; else print $NF}')

terminal-notifier \
  -title "Claude Code - $dir_context" \
  -message "Done" \
  -sound Glass \
  -contentImage "$HOME/.claude/icons/claude.png"

# Clear ⏺ from any tmux windows — find by name rather than relying on $TMUX
tmux list-windows -a -F "#{session_name}:#{window_index} #{window_name}" 2>/dev/null \
  | grep "^[^ ]* ⏺ " \
  | while IFS=' ' read -r target name; do
      clean="${name#⏺ }"
      tmux rename-window -t "$target" "$clean" 2>/dev/null || true
      tmux set-window-option -t "$target" automatic-rename on 2>/dev/null || true
    done
