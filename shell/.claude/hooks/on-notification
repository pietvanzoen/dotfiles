#!/usr/bin/env bash
# Hook: Notification (shared handler)
# Usage: on-notification <message> <sound>

message="${1:?message required}"
sound="${2:?sound required}"

input=$(cat)

set_claude_state() {  # args: thinking needs_input done
  [ -n "$TMUX" ] || return
  tmux set-window-option @claude-thinking "${1}" 2>/dev/null || true
  tmux set-window-option @claude-needs-input "${2}" 2>/dev/null || true
  tmux set-window-option @claude-done "${3}" 2>/dev/null || true
}
set_claude_state 0 1 0

cwd=$(echo "$input" | jq -r '.cwd // ""')
if [ -z "$cwd" ] || [ "$cwd" = "null" ]; then
  cwd=$(pwd)
fi

dir_context=$(basename "$cwd")

terminal-notifier \
  -title "$dir_context - Claude Code" \
  -message "$message" \
  -sound "$sound" \
  -contentImage "$HOME/.claude/icons/claude.png"

json_msg=$(echo "$input" | jq -r '.message // ""')
ntfy_msg="${json_msg:-$message}"
ntfy-notify --away-only --topic claude --tags robot "$dir_context - Claude Code" "$ntfy_msg"
