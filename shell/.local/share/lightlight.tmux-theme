# Tmux theme — solarized dark with rounded pills
# Uses terminal ANSI colours (iTerm2 solarized mapping)
#
# Solarized ANSI reference:
#   colour0=base02  colour8=base03  colour1=red     colour9=orange
#   colour2=green   colour10=base01 colour3=yellow  colour11=base00
#   colour4=blue    colour12=base0  colour5=magenta colour13=violet
#   colour6=cyan    colour14=base1  colour7=base2   colour15=base3

# ── General ──────────────────────────────────────────────────────────
set -g status on
set -g status-justify centre
set -g status-style "bg=colour8,fg=colour12"
set -g status-left-length 100
set -g status-right-length 120

# ── Messages ─────────────────────────────────────────────────────────
set -g message-style "fg=colour8,bg=colour3"
set -g message-command-style "fg=colour8,bg=colour3"

# ── Pane borders ─────────────────────────────────────────────────────
set -g pane-active-border-style "fg=colour4"
set -g pane-border-style "fg=colour10"
set -g pane-border-format " #{pane_current_command} "

# ── Status left — session pill (turns orange on prefix) ──────────────
set -g status-left "\
#[fg=colour15,bg=#{?client_prefix,colour9,colour4},bold] #S \
#[fg=#{?client_prefix,colour9,colour4},bg=colour8,nobold]"

# ── Status right — git branch + other sessions ──────────────────────
set -g status-right "\
#[fg=colour12,bg=colour8]#(tmux-git-branch #{pane_current_path})\
 #(tmux list-sessions -F '##{session_name}' | grep -vF '#S' | while read -r s; do printf '#[fg=colour12,bg=colour8]#[fg=colour8,bg=colour12] %%s #[fg=colour12,bg=colour8]' "\$s"; done)"

# ── Window status ────────────────────────────────────────────────────
setw -g window-status-separator "  "

# Inactive windows — muted text, no background
setw -g window-status-style "fg=colour12,bg=colour8"
setw -g window-status-format " #I #{=|35|…:window_name}#{?#{@claude-thinking}, ◎,}#{?#{@claude-needs-input}, ?,}#{?#{@claude-done}, ●,} "

# Active window — cyan pill
setw -g window-status-current-format "\
#[fg=colour6,bg=colour8]\
#[fg=colour15,bg=colour6,bold] #I #{=|25|…:window_name}#{?#{@claude-thinking}, ◎,}#{?#{@claude-needs-input}, ?,}#{?#{@claude-done}, ●,} \
#[fg=colour6,bg=colour8,nobold]"

# Bell/activity — orange text
setw -g window-status-activity-style "fg=colour9,bg=colour8"
setw -g window-status-bell-style "fg=colour9,bg=colour8"
