#!/bin/sh
# Start the cutr tmuxinator session, optionally targeting a worktree path.
# Usage: cutr-start [-f] [path]
#   -f, --force  Restart even if a session is already running for this directory
#   path         Optional path to a cutr-server worktree. Defaults to cwd if it
#                looks like a cutr repo, otherwise uses the main repo.

set -eu

DEFAULT_ROOT=~/repos/github.com/cutr-dev/cutr-server
FORCE=0

for arg in "$@"; do
  case "$arg" in
    -f|--force) FORCE=1 ;;
    -*) echo "Unknown flag: $arg" >&2; exit 1 ;;
  esac
done

# Find first non-flag argument as path
PATH_ARG=""
for arg in "$@"; do
  case "$arg" in
    -*) ;;
    *) PATH_ARG="$arg"; break ;;
  esac
done

if [ -n "$PATH_ARG" ]; then
  CUTR_ROOT="$(cd "$PATH_ARG" && pwd)"
elif [ -f "./server/package.json" ]; then
  CUTR_ROOT="$(pwd)"
else
  CUTR_ROOT="$(cd "$DEFAULT_ROOT" && pwd)"
fi

export CUTR_ROOT CUTR_DIR="$CUTR_ROOT"

# Inside Rex (and not tmux): build the cutr.yaml layout as a Rex session.
if [ -n "${REX_SESSION:-}" ] && [ -z "${TMUX:-}" ]; then
  echo "==> Running on_project_start in $CUTR_ROOT"
  (cd "$CUTR_ROOT" && yarn && yarn install:dotenv)

  # Close existing cutr sessions, except the one we're running in.
  rex ls --json | jq -r --arg self "$REX_SESSION" \
    '(.sessions? // .)[] | select(.label == "cutr" and .session_id != $self) | .session_id' |
    while read -r old; do
      echo "--> Closing existing Rex session $old"
      rex kill "$old"
    done

  echo "==> Creating Rex session cutr"
  sid=$(rex new cutr -c "$CUTR_ROOT" --window Cutr --json | jq -er '.session_id')
  server=$(rex session inspect "$sid" --json | jq -er '.windows[0].focused_block_id')
  split() { # anchor direction ratio label
    rex split -s "$sid" -b "$1" --split="$2" --ratio "$3" --label "$4" --focus=false \
      -c "$CUTR_ROOT" --json | jq -er '.block_ids[0]'
  }
  # Left 69%: server / workers. Right 31%: ui (16%) / cutlist (14%) / dev (70%).
  ui=$(split "$server" right 31 ui)
  workers=$(split "$server" below 50 workers)
  cutlist=$(split "$ui" below 84 cutlist)
  dev=$(split "$cutlist" below 83 dev)

  # Type into the shells like tmuxinator does, so ctrl+c leaves a usable prompt.
  run() { rex send -s "$sid" -b "$1" "$2" && rex send-key -s "$sid" -b "$1" enter; }
  run "$server" 'cd server && yarn dev | spacer'
  run "$workers" 'cd server && yarn dev:worker | spacer'
  run "$ui" 'cd ui && yarn dev'
  run "$cutlist" 'cd cutlist && yarn dev'
  run "$dev" "CUTR_DIR='$CUTR_ROOT' cutr-migrate"

  rex "do" session.select session_id="$sid" || true
  exit 0
fi

if [ "$FORCE" -eq 0 ] && tmux has-session -t cutr 2>/dev/null; then
  RUNNING_ROOT="$(tmux showenv -t cutr CUTR_ROOT 2>/dev/null | sed 's/^CUTR_ROOT=//')"
  if [ "$RUNNING_ROOT" = "$CUTR_ROOT" ]; then
    echo "==> cutr is already running at $CUTR_ROOT (use -f to restart)"
    exit 0
  fi
fi

echo "==> Starting cutr at $CUTR_ROOT"
tmuxinator stop cutr 2>/dev/null || true
tmuxinator start cutr
