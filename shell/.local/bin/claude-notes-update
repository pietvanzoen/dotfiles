#!/usr/bin/env bash
# Update .claude-notes with an AI summary, preserving the prompt: and stage: lines.
# Usage: claude-notes-update [--stage <name>] "summary text here"
#        claude-notes-update --refresh   (refresh PR info only, no summary needed)
# Fetches and refreshes PR info (number, state, approval) via gh.

set -euo pipefail

# Disabled — claude-notes no longer used. Script kept as no-op so callers don't break.
exit 0

# Parse flags
stage_arg=""
refresh_mode=false
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --stage)
      stage_arg="${2:-}"
      if [ -z "$stage_arg" ]; then
        echo "Usage: claude-notes-update [--stage <name>] <summary>" >&2
        exit 1
      fi
      shift 2
      ;;
    --refresh)
      refresh_mode=true
      shift
      ;;
    *)
      echo "Unknown flag: $1" >&2
      exit 1
      ;;
  esac
done

summary="${1:-}"
if [ "$refresh_mode" = false ] && [ -z "$summary" ]; then
  echo "Usage: claude-notes-update [--stage <name>] <summary>" >&2
  exit 1
fi

notes_file=".claude-notes"

# Preserve existing lines
prompt_line=""
stage_line=""
summary_line=""
next_line=""
if [ -f "$notes_file" ]; then
  prompt_line=$(grep '^prompt:' "$notes_file" 2>/dev/null || true)
  stage_line=$(grep '^stage:' "$notes_file" 2>/dev/null || true)
  next_line=$(grep '^next:' "$notes_file" 2>/dev/null || true)
  # Summary is the first non-metadata line (no key: prefix)
  summary_line=$(grep -v '^prompt:\|^stage:\|^next:\|^pr:' "$notes_file" 2>/dev/null | head -1 || true)
fi

# --stage flag overrides preserved stage
if [ -n "$stage_arg" ]; then
  stage_line="stage: $stage_arg"
fi

# Refresh PR info
pr_line=""
branch=$(git branch --show-current 2>/dev/null || true)
if [ -n "$branch" ] && [ "$branch" != "main" ] && [ "$branch" != "master" ]; then
  pr_json=$(gh pr view --json number,state,url,reviews 2>/dev/null || true)
  if [ -n "$pr_json" ] && [ "$pr_json" != "null" ]; then
    pr_num=$(echo "$pr_json" | jq -r '.number // empty')
    pr_state=$(echo "$pr_json" | jq -r '.state // empty' | tr '[:upper:]' '[:lower:]')
    pr_url=$(echo "$pr_json" | jq -r '.url // empty')
    approved=$(echo "$pr_json" | jq -r '[.reviews[]? | select(.state == "APPROVED")] | length')
    if [ -n "$pr_num" ]; then
      if [ "${approved:-0}" -gt 0 ]; then
        pr_line="pr: #${pr_num} ${pr_state} approved ${pr_url}"
      else
        pr_line="pr: #${pr_num} ${pr_state} ${pr_url}"
      fi
    fi
  fi
fi

# --refresh mode: just update PR info, preserve everything else
if [ "$refresh_mode" = true ]; then
  {
    [ -n "$prompt_line" ] && echo "$prompt_line"
    [ -n "$stage_line" ] && echo "$stage_line"
    [ -n "$summary_line" ] && echo "$summary_line"
    [ -n "$next_line" ] && echo "$next_line"
    [ -n "$pr_line" ] && echo "$pr_line"
    true
  } > "$notes_file"
  exit 0
fi

# Split summary on " → " into done/next parts
done_part="$summary"
next_part=""
if [[ "$summary" == *" → "* ]]; then
  done_part="${summary%% → *}"
  next_part="${summary#* → }"
fi

# Truncate next to fit the NEXT column width in claude-sessions
NEXT_W=40
if [ ${#next_part} -gt $NEXT_W ]; then
  next_part="${next_part:0:$((NEXT_W - 1))}…"
fi

# Write notes file
{
  [ -n "$prompt_line" ] && echo "$prompt_line"
  [ -n "$stage_line" ] && echo "$stage_line"
  echo "$done_part"
  [ -n "$next_part" ] && echo "next: $next_part"
  [ -n "$pr_line" ] && echo "$pr_line"
  true
} > "$notes_file"
