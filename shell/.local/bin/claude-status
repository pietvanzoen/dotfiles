#!/usr/bin/env python3
# Show status of all active Claude Code sessions across projects.
# Usage: claude-status [-a|--all] [-p|--pr] [--prune]
#   -a, --all    Show all sessions regardless of age (default: last 30 days)
#   -p, --pr     Fetch PR info from GitHub (slower — requires gh)
#   --prune      Remove project dirs whose cwd no longer exists

import json
import os
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

# ANSI colors — disabled when not a tty
USE_COLOR = sys.stdout.isatty()

def c(text, *codes):
    if not USE_COLOR:
        return text
    return f"\033[{';'.join(str(x) for x in codes)}m{text}\033[0m"

def hyperlink(url, text):
    if not USE_COLOR or not url:
        return text
    return f"\033]8;;{url}\033\\{text}\033]8;;\033\\"

DIM    = 2
BOLD   = 1
RED    = 31
YELLOW = 33
GREEN  = 32
CYAN   = 36
BLUE   = 34

PROJECTS_DIR = os.path.expanduser("~/.claude/projects")
MAX_AGE_DAYS = 30

show_all = False
fetch_pr = False
prune = False

for arg in sys.argv[1:]:
    if arg in ("-a", "--all"):
        show_all = True
    elif arg in ("-p", "--pr"):
        fetch_pr = True
    elif arg == "--prune":
        prune = True
    else:
        print(f"Usage: claude-status [-a|--all] [-p|--pr] [--prune]", file=sys.stderr)
        sys.exit(1)

now = int(time.time())


def human_age(age):
    if age < 3600:
        return "today"
    elif age < 86400:
        return f"{age // 3600}h ago"
    elif age < 172800:
        return "yesterday"
    else:
        return f"{age // 86400}d ago"


def read_session(jsonl_path):
    """Return (cwd, branch) from the last meaningful line of a jsonl file."""
    cwd = branch = ""
    try:
        with open(jsonl_path) as f:
            for raw in f:
                try:
                    d = json.loads(raw)
                    if d.get("cwd"):
                        cwd = d["cwd"]
                    if d.get("gitBranch"):
                        branch = d["gitBranch"]
                except (json.JSONDecodeError, TypeError):
                    pass
    except OSError:
        pass
    return cwd, branch


def git_dirty_count(cwd):
    try:
        out = subprocess.check_output(
            ["git", "-C", cwd, "status", "--porcelain"],
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
        return len(out.splitlines())
    except (subprocess.SubprocessError, FileNotFoundError):
        return 0


def gh_pr_info(cwd, branch):
    try:
        out = subprocess.check_output(
            ["gh", "pr", "list", "--head", branch, "--state", "all",
             "--limit", "1", "--json", "number,state,url"],
            cwd=cwd,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        items = json.loads(out)
        if items:
            item = items[0]
            return f"#{item['number']} {item['state'].lower()} {item['url']}"
    except (subprocess.SubprocessError, FileNotFoundError, json.JSONDecodeError):
        pass
    return "—"


def make_label(cwd, branch):
    if "/.claude/worktrees/" in cwd:
        parent = os.path.basename(cwd[: cwd.index("/.claude/worktrees/")])
        parts = branch.split("-")
        issue_id = "-".join(parts[:2]) if len(parts) >= 2 else branch
        name = f"{parent}/{issue_id}"
    else:
        name = f"{os.path.basename(os.path.dirname(cwd))}/{os.path.basename(cwd)}"
    if len(name) > 32:
        return name[:29] + "..."
    return name


# --- Collect projects ---

# Map cwd -> (mtime, jsonl_path, age) — keep most recent session per cwd
best = {}

for entry in os.scandir(PROJECTS_DIR):
    if not entry.is_dir():
        continue
    latest_jsonl = None
    latest_mtime = 0
    for f in os.scandir(entry.path):
        if not f.name.endswith(".jsonl"):
            continue
        mtime = int(f.stat().st_mtime)
        if mtime > latest_mtime:
            latest_mtime = mtime
            latest_jsonl = f.path

    if not latest_jsonl:
        continue

    age = now - latest_mtime
    if not show_all and age > MAX_AGE_DAYS * 86400:
        continue

    cwd, branch = read_session(latest_jsonl)
    if not cwd:
        continue

    if prune:
        if not os.path.isdir(cwd):
            print(f"Pruning: {entry.path}")
            shutil.rmtree(entry.path)
        continue

    if not os.path.isdir(cwd):
        continue

    # Keep only the most recent session per cwd
    if cwd not in best or latest_mtime > best[cwd][0]:
        best[cwd] = (latest_mtime, latest_jsonl, age, branch)

if prune:
    sys.exit(0)

if not best:
    print("No active Claude sessions found.")
    sys.exit(0)

# Sort by mtime descending
projects = sorted(best.items(), key=lambda x: x[1][0], reverse=True)

# --- Fetch git status and (optionally) PR info in parallel ---

def fetch_project_data(item):
    cwd, (mtime, jsonl, age, branch) = item
    dirty = git_dirty_count(cwd)
    notes = pr = ""
    notes_path = os.path.join(cwd, ".claude-notes")
    if os.path.isfile(notes_path):
        try:
            with open(notes_path) as f:
                lines = [l.strip() for l in f.readlines()]
            notes = lines[0] if lines else ""
            for line in lines[1:]:
                if line.startswith("pr:"):
                    pr = line[3:].strip()
                    break
    # pr may be "#142 open" or "#142 open https://..."
        except OSError:
            pass
    # --pr flag overrides with a live gh lookup
    if fetch_pr and branch:
        pr = gh_pr_info(cwd, branch)
    if not pr:
        pr = "—"
    return cwd, branch, age, dirty, pr, notes

with ThreadPoolExecutor(max_workers=8) as pool:
    results = list(pool.map(fetch_project_data, projects))

# --- Output ---

BRANCH_W = 22
header = (f"  {'PROJECT':<32}  {'BRANCH':<{BRANCH_W}}  {'STATUS':<12}  {'PR':<16}  LAST ACTIVE")
divider = (f"  {'─' * 32}  {'─' * BRANCH_W}  {'─' * 12}  {'─' * 16}  {'─' * 11}")
print(c(header, BOLD))
print(c(divider, DIM))
print()

for cwd, branch, age, dirty, pr, notes in results:
    label = make_label(cwd, branch)
    branch_str = branch[:BRANCH_W - 1] + "…" if len(branch) > BRANCH_W else branch
    age_str = human_age(age)

    if dirty:
        status_str = c(f"dirty ({dirty})", YELLOW)
        status_pad = f"dirty ({dirty})"
    else:
        status_str = c("clean", GREEN)
        status_pad = "clean"

    if pr.startswith("#"):
        parts = pr.split()
        pr_url = parts[2] if len(parts) >= 3 and parts[2].startswith("http") else ""
        pr_display = " ".join(parts[:2])  # "#142 open" without URL
        state = parts[1] if len(parts) >= 2 else ""
        pr_color = GREEN if state == "open" else (BLUE if state == "merged" else DIM)
        pr_str = c(hyperlink(pr_url, pr_display), pr_color)
        pr = pr_display  # use display text for padding calculation
    else:
        pr_str = c(pr, DIM)

    # Pad manually since color codes throw off f-string width
    label_col  = c(label, BOLD)      + " " * (32 - len(label))
    branch_col = c(branch_str, DIM)  + " " * (BRANCH_W - len(branch_str))
    status_col = status_str          + " " * (12 - len(status_pad))
    pr_col     = pr_str              + " " * (16 - len(pr))

    print(f"  {label_col}  {branch_col}  {status_col}  {pr_col}  {c(age_str, DIM)}")
    if notes:
        print(f"  {c('└', DIM)} {notes}")
    print()
