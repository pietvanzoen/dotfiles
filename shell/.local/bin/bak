#!/usr/bin/env bash
set -e
USAGE="Usage: $(basename "$0") [path...]
Backup or restore files by adding or removing ~ from the end of the path."

if [ $# -lt 1 ]; then
  echo "$USAGE"
  exit 1
fi

for p in "$@"; do
  p="$(echo "$p" | sed 's/\/$//')"
  if [[ "$p" == *~ ]]; then
    new_path="${p%\~}"
  else
    new_path="$p~"
  fi

  mv -vi "$p" "$new_path"
done
