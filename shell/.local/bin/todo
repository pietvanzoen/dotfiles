#!/usr/bin/env bash
set -euo pipefail

GLOBAL_TODO="$HOME/.claude/todo.md"

# Colors (when writing to a terminal or FORCE_COLOR is set)
if [ -t 1 ] || [ "${FORCE_COLOR:-0}" != "0" ]; then
  CYAN=$'\033[1;36m'
  YELLOW=$'\033[1;33m'
  DIM=$'\033[2m'
  RESET=$'\033[0m'
else
  CYAN='' YELLOW='' DIM='' RESET=''
fi

get_project_todo() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
  echo "$root/.todo.md"
}

add_item() {
  local file="$1" text="$2"
  mkdir -p "$(dirname "$file")"
  echo "- [ ] $(date +%Y-%m-%d) $text" >> "$file"
  echo "==> Added to $(basename "$(dirname "$file")")/.todo.md"
}

relative_date() {
  local date_str="$1" today epoch_date epoch_today diff_days
  today=$(date +%Y-%m-%d)
  [ "$date_str" = "$today" ] && { echo "today"; return; }
  epoch_date=$(date -j -f "%Y-%m-%d" "$date_str" "+%s" 2>/dev/null) || { echo "$date_str"; return; }
  epoch_today=$(date +%s)
  diff_days=$(( (epoch_today - epoch_date) / 86400 ))
  if   [ "$diff_days" -eq 1 ];   then echo "yesterday"
  elif [ "$diff_days" -lt 7 ];   then echo "${diff_days}d ago"
  elif [ "$diff_days" -lt 30 ];  then echo "$((diff_days / 7))w ago"
  else echo "$date_str"
  fi
}

HHGTTG_QUOTES=(
  "I love deadlines. I love the whooshing noise they make as they go by."
  "Time is an illusion. Lunchtime doubly so."
  "Nothing travels faster than the speed of light, with the possible exception of bad news."
  "The knack of flying is learning how to throw yourself at the ground and miss."
  "In the beginning the Universe was created. This has made a lot of people very angry and been widely regarded as a bad move."
  "For a moment, nothing happened. Then, after a second or so, nothing continued to happen."
)

empty_state() {
  local idx=$(( RANDOM % ${#HHGTTG_QUOTES[@]} ))
  printf "  %s%s%s\n" "$DIM" "${HHGTTG_QUOTES[$idx]}" "$RESET"
}

print_items() {
  local file="$1"
  local count=0
  while IFS= read -r line; do
    local date_str text rel
    date_str=$(echo "$line" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}')
    text="${line#*- \[ \] ????-??-?? }"
    rel=$(relative_date "$date_str")
    count=$(( count + 1 ))
    printf "  ${YELLOW}%s.${RESET} ${DIM}%-10s${RESET} %s\n" "$count" "$rel" "$text"
  done < <(grep '^- \[ \]' "$file")
  [ "$count" -eq 0 ] && empty_state
}

list_items() {
  local project_file global_file shown=false

  if project_file=$(get_project_todo) && [ -f "$project_file" ]; then
    echo "${CYAN}==> Project: $(basename "$(dirname "$project_file")")${RESET}"
    print_items "$project_file" || true
    shown=true
  fi

  global_file="$GLOBAL_TODO"
  if [ -f "$global_file" ]; then
    echo "${CYAN}==> Global${RESET}"
    print_items "$global_file" || true
    shown=true
  fi

  if [ "$shown" = false ]; then
    echo "${DIM}==> No todo files found${RESET}"
  fi
}

mark_done() {
  local num="$1"
  local file

  if file=$(get_project_todo) && [ -f "$file" ]; then
    : # use project file
  else
    file="$GLOBAL_TODO"
  fi

  if [ ! -f "$file" ]; then
    echo "==> No todo file found" >&2
    exit 1
  fi

  # Find the Nth open item (1-based)
  local line_num
  line_num=$(grep -n '^- \[ \]' "$file" | sed -n "${num}p" | cut -d: -f1) || true

  if [ -z "$line_num" ]; then
    echo "==> No open item #$num in $file" >&2
    exit 1
  fi

  sed -i'' -e "${line_num}s/^- \[ \]/- [x]/" "$file"
  echo "==> Marked item #$num as done in $(basename "$(dirname "$file")")/.todo.md"
}

# Parse arguments
global=false
done_num=""

# Support shorthand: todo done N
if [[ "${1:-}" == "done" && "${2:-}" =~ ^[0-9]+$ ]]; then
  mark_done "$2"
  exit 0
fi

while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --global)
      global=true
      shift
      ;;
    --done)
      done_num="${2:-}"
      if [ -z "$done_num" ]; then
        echo "Usage: todo --done <number>" >&2
        exit 1
      fi
      shift 2
      ;;
    *)
      echo "Unknown flag: $1" >&2
      exit 1
      ;;
  esac
done

text="${*:-}"

if [ -n "$done_num" ]; then
  mark_done "$done_num"
elif [ -n "$text" ]; then
  if [ "$global" = true ]; then
    add_item "$GLOBAL_TODO" "$text"
  elif project_file=$(get_project_todo); then
    add_item "$project_file" "$text"
  else
    add_item "$GLOBAL_TODO" "$text"
  fi
else
  list_items
fi
