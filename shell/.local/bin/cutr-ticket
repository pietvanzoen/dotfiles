#!/usr/bin/env bash
# cutr-ticket — open a Linear ticket in a Rex window running cutr-task.
#
# Invoked by Linear's "Work on issue → Custom script" feature, or directly from the CLI.
#
# Usage: cutr-ticket [--id <IDENTIFIER>] [--branch <BRANCH_NAME>]
#
# Linear passes context as both args (via coding-tools.json) and env vars:
#   LINEAR_ISSUE_IDENTIFIER    e.g. CTR-14058
#   LINEAR_ISSUE_BRANCH_NAME   e.g. ctr-14058-some-description

set -euo pipefail

# Rex only puts its CLI on PATH inside Rex terminals; Linear launches us from outside.
PATH="$HOME/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS:$PATH"

REX_SESSION_NAME="cutr-dev"
PROMPT="read ticket and plan"
CWD="$HOME/repos/github.com/cutr-dev/cutr-server"

usage() {
  echo "Usage: cutr-ticket [--id <IDENTIFIER>] [--branch <BRANCH_NAME>]" >&2
  exit 1
}

# --- Parse arguments (args take precedence over env vars) ---
TICKET_ID="${LINEAR_ISSUE_IDENTIFIER:-}"
BRANCH="${LINEAR_ISSUE_BRANCH_NAME:-}"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --id)
      [[ $# -gt 1 ]] || usage
      TICKET_ID="$2"; shift 2 ;;
    --branch)
      [[ $# -gt 1 ]] || usage
      BRANCH="$2"; shift 2 ;;
    -h|--help) usage ;;
    *) echo "error: unknown argument: $1" >&2; usage ;;
  esac
done

if [[ -z "$BRANCH" ]]; then
  echo "error: --branch (or LINEAR_ISSUE_BRANCH_NAME) is required" >&2
  usage
fi

# --- Derive window name from ticket id (or extract from branch) ---
if [[ -z "$TICKET_ID" ]]; then
  TICKET_ID="$(echo "$BRANCH" | grep -oE '^[a-zA-Z]+-[0-9]+')" || TICKET_ID="$BRANCH"
fi
WINDOW_NAME="$(echo "$TICKET_ID" | tr '[:upper:]' '[:lower:]')"

# cutr-task is a zsh function (worktree + setup + Claude split), so run it in an interactive zsh.
# Drop into a shell afterwards so the window survives cutr-task's editor exiting.
# shellcheck disable=SC2016 # $1/$2 expand inside the zsh, not here
CMD=(zsh -ic 'cutr-task "$1" "$2"; exec zsh' cutr-ticket "$BRANCH" "$PROMPT")

if ! rex session inspect "$REX_SESSION_NAME" >/dev/null; then
  echo "==> Creating Rex session: $REX_SESSION_NAME"
  rex new "$REX_SESSION_NAME" --window "$WINDOW_NAME" -c "$CWD" --shell none -- "${CMD[@]}" >/dev/null
elif rex window focus -s "$REX_SESSION_NAME" "$WINDOW_NAME" >/dev/null; then
  echo "==> Selected existing window: $WINDOW_NAME"
else
  echo "==> Opening new window: $WINDOW_NAME"
  rex window new -s "$REX_SESSION_NAME" "$WINDOW_NAME" -c "$CWD" --shell none -- "${CMD[@]}" >/dev/null
fi

echo "==> Done."
echo "    Branch:  $BRANCH"
echo "    Window:  ${REX_SESSION_NAME}:${WINDOW_NAME}"

open -a "Rex Beta"
