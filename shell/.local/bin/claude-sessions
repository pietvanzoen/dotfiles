#!/usr/bin/env python3
# Show status of all active Claude Code sessions across projects.
# Usage: claude-sessions [-a|--all] [-i|--ids] [-p|--pr] [-w|--watch [SECS]] [--prune] [--prune-merged] [--delete ID]
#   -a, --all         Show all sessions regardless of age (default: last 30 days)
#   -i, --ids         Show session IDs (for use with --delete)
#   -p, --pr          Fetch PR info from GitHub (slower — requires gh)
#   -w, --watch [N]   Live-updating dashboard, refreshing every N seconds (default: 5)
#   --prune           Remove project dirs whose cwd no longer exists
#   --prune-merged    Remove project dirs and worktrees for merged PRs
#   --delete ID       Delete a specific session by its short ID

import atexit
import json
import os
import re
import signal
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

# ANSI colors — disabled when not a tty
USE_COLOR = sys.stdout.isatty()

def c(text, *codes):
    if not USE_COLOR:
        return text
    return f"\033[{';'.join(str(x) for x in codes)}m{text}\033[0m"

def hyperlink(url, text):
    if not USE_COLOR or not url:
        return text
    return f"\033]8;;{url}\033\\{text}\033]8;;\033\\"

DIM    = 2
BOLD   = 1
RED    = 31
YELLOW = 33
GREEN  = 32
CYAN   = 36
BLUE   = 34

PROJECTS_DIR = os.path.expanduser("~/.claude/projects")
MAX_AGE_DAYS = 30

show_all = False
show_ids = False
fetch_pr = False
prune = False
prune_merged = False
delete_id = None
watch_interval = None

args = sys.argv[1:]
i = 0
while i < len(args):
    arg = args[i]
    if arg in ("-a", "--all"):
        show_all = True
    elif arg in ("-i", "--ids"):
        show_ids = True
    elif arg in ("-p", "--pr"):
        fetch_pr = True
    elif arg in ("-w", "--watch"):
        watch_interval = 5
        if i + 1 < len(args) and args[i + 1].isdigit():
            i += 1
            watch_interval = int(args[i])
    elif arg == "--prune":
        prune = True
    elif arg == "--prune-merged":
        prune_merged = True
        show_all = True  # consider all sessions, not just recent ones
    elif arg == "--delete":
        i += 1
        if i >= len(args):
            print("--delete requires a session ID", file=sys.stderr)
            sys.exit(1)
        delete_id = args[i]
        show_all = True
    else:
        print(f"Usage: claude-sessions [-a|--all] [-i|--ids] [-p|--pr] [-w|--watch [SECS]] [--prune] [--prune-merged] [--delete ID]", file=sys.stderr)
        sys.exit(1)
    i += 1

if watch_interval is not None and (delete_id or prune or prune_merged):
    print("--watch cannot be combined with --delete, --prune, or --prune-merged", file=sys.stderr)
    sys.exit(1)

LOCKFILE = "/tmp/claude-sessions-watch.pid"

now = int(time.time())


def human_age(age):
    if age < 60:
        return "just now"
    elif age < 3600:
        return f"{age // 60}m ago"
    elif age < 86400:
        return f"{age // 3600}h ago"
    elif age < 172800:
        return "yesterday"
    else:
        return f"{age // 86400}d ago"


def read_notes(cwd):
    """Return (summary, prompt_line, pr_str) from .claude-notes, or ('', '', '') if absent."""
    notes_path = os.path.join(cwd, ".claude-notes")
    if not os.path.isfile(notes_path):
        return "", "", ""
    try:
        with open(notes_path) as f:
            lines = [l.strip() for l in f.readlines()]
        summary = next((l for l in lines if not l.startswith(("prompt:", "pr:"))), "")
        prompt_line = next((l[7:].strip() for l in lines if l.startswith("prompt:")), "")
        pr_str = next((l[3:].strip() for l in lines if l.startswith("pr:")), "")
        return summary, prompt_line, pr_str
    except OSError:
        return "", "", ""


def pr_state_from_notes(cwd):
    """Return the PR state string from .claude-notes (e.g. 'merged'), or ''."""
    _, _prompt, pr_str = read_notes(cwd)
    if pr_str:
        parts = pr_str.split()
        return parts[1].lower() if len(parts) >= 2 else ""
    return ""


def find_worktree_root(cwd):
    """Return the main repo root if cwd is a git worktree, else None."""
    try:
        # git worktree list prints the main worktree first
        out = subprocess.check_output(
            ["git", "worktree", "list", "--porcelain"],
            cwd=cwd,
            stderr=subprocess.DEVNULL,
        ).decode()
        worktrees = [
            line[9:] for line in out.splitlines() if line.startswith("worktree ")
        ]
        if len(worktrees) >= 2 and os.path.abspath(cwd) != os.path.abspath(worktrees[0]):
            return worktrees[0]
    except subprocess.SubprocessError:
        pass
    return None


def remove_worktree(cwd):
    """Remove a git worktree at cwd. Returns True on success."""
    repo_root = find_worktree_root(cwd)
    if not repo_root:
        return False
    try:
        subprocess.run(
            ["git", "worktree", "remove", "--force", cwd],
            cwd=repo_root,
            check=True,
            capture_output=True,
        )
        return True
    except subprocess.SubprocessError:
        return False


def read_session(jsonl_path):
    """Return (cwd, branch) from the last meaningful line of a jsonl file."""
    cwd = branch = ""
    try:
        with open(jsonl_path) as f:
            for raw in f:
                try:
                    d = json.loads(raw)
                    if d.get("cwd"):
                        cwd = d["cwd"]
                    if d.get("gitBranch"):
                        branch = d["gitBranch"]
                except (json.JSONDecodeError, TypeError):
                    pass
    except OSError:
        pass
    return cwd, branch


def git_dirty_count(cwd):
    try:
        out = subprocess.check_output(
            ["git", "-C", cwd, "status", "--porcelain"],
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
        return len(out.splitlines())
    except (subprocess.SubprocessError, FileNotFoundError):
        return 0


def gh_pr_info(cwd, branch):
    try:
        out = subprocess.check_output(
            ["gh", "pr", "list", "--head", branch, "--state", "all",
             "--limit", "1", "--json", "number,state,url"],
            cwd=cwd,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        items = json.loads(out)
        if items:
            item = items[0]
            return f"#{item['number']} {item['state'].lower()} {item['url']}"
    except (subprocess.SubprocessError, FileNotFoundError, json.JSONDecodeError):
        pass
    return "—"


NAME_W = 50
try:
    cols = os.get_terminal_size().columns
except OSError:
    cols = 120

TICKET_RE = re.compile(r'^[a-z]+-\d+', re.IGNORECASE)

def make_label(cwd, branch):
    """Return (project, branch_suffix) for separate styling."""
    project = os.path.basename(cwd)
    if branch:
        m = TICKET_RE.match(branch)
        if m and m.group(0).lower() in project.lower():
            display_branch = branch[len(m.group(0)):].lstrip("-") or branch
        else:
            display_branch = branch
    else:
        display_branch = ""
    suffix = f":{display_branch}" if display_branch else ""
    total = len(project) + len(suffix)
    if total > NAME_W:
        # Truncate branch first, then project if needed
        avail = NAME_W - len(project) - 1  # -1 for ellipsis
        if avail >= 2:  # room for ":" + at least 1 char
            suffix = f":{display_branch[:avail - 1]}…"
        else:
            suffix = ""
            project = project[:NAME_W - 1] + "…"
    return project, suffix


def run():
    global now
    now = int(time.time())

    # --- Collect projects ---

    # Map cwd -> (mtime, jsonl_path, age, branch, project_dir) — keep most recent session per cwd
    best = {}

    for entry in os.scandir(PROJECTS_DIR):
        if not entry.is_dir():
            continue
        latest_jsonl = None
        latest_mtime = 0
        for f in os.scandir(entry.path):
            if not f.name.endswith(".jsonl"):
                continue
            mtime = int(f.stat().st_mtime)
            if mtime > latest_mtime:
                latest_mtime = mtime
                latest_jsonl = f.path

        if not latest_jsonl:
            continue

        age = now - latest_mtime
        if not show_all and age > MAX_AGE_DAYS * 86400:
            continue

        cwd, branch = read_session(latest_jsonl)
        if not cwd:
            continue

        # Short ID: first 7 chars of the most recent session UUID
        sid = os.path.basename(latest_jsonl).replace(".jsonl", "")[:7]

        if delete_id:
            if sid.startswith(delete_id) or delete_id == sid:
                proj, suf = make_label(cwd, branch)
                is_worktree = os.path.isdir(cwd) and find_worktree_root(cwd)
                print(f"  Session: {proj}{suf} ({sid})")
                print(f"  Path:    {cwd}")
                if is_worktree:
                    print(f"  Worktree will also be removed")
                answer = input("\n  Delete this session? [y/N] ")
                if answer.lower() in ("y", "yes"):
                    if is_worktree:
                        if remove_worktree(cwd):
                            print(f"  Removed worktree: {cwd}")
                    print(f"  Deleted: {proj}{suf} ({sid})")
                    shutil.rmtree(entry.path)
                else:
                    print("  Skipped.")
            continue

        if prune:
            if not os.path.isdir(cwd):
                print(f"Pruning: {entry.path}")
                shutil.rmtree(entry.path)
            continue

        if prune_merged:
            if not os.path.isdir(cwd):
                continue
            state = pr_state_from_notes(cwd)
            # Fall back to gh if notes don't have PR state
            if not state and branch:
                pr_str = gh_pr_info(cwd, branch)
                if pr_str and pr_str != "—":
                    state = pr_str.split()[1] if len(pr_str.split()) >= 2 else ""
            if state == "merged":
                proj, suf = make_label(cwd, branch)
                if remove_worktree(cwd):
                    print(f"  Removed worktree: {cwd}")
                print(f"  Pruned: {proj}{suf}")
                shutil.rmtree(entry.path)
            continue

        if not os.path.isdir(cwd):
            continue

        # Keep only the most recent session per cwd
        if cwd not in best or latest_mtime > best[cwd][0]:
            best[cwd] = (latest_mtime, latest_jsonl, age, branch, entry.path)

    if delete_id or prune or prune_merged:
        sys.exit(0)

    if not best:
        print("No active Claude sessions found.")
        return

    # Sort by mtime descending
    projects = sorted(best.items(), key=lambda x: x[1][0], reverse=True)

    # --- Fetch git status and (optionally) PR info in parallel ---

    def fetch_project_data(item):
        cwd, (mtime, jsonl, age, branch, project_dir) = item
        dirty = git_dirty_count(cwd)
        notes, prompt_line, pr = read_notes(cwd)
        sid = os.path.basename(jsonl).replace(".jsonl", "")[:7]
        # --pr flag overrides with a live gh lookup
        if fetch_pr and branch:
            pr = gh_pr_info(cwd, branch)
        if not pr:
            pr = "—"
        return cwd, branch, age, dirty, pr, notes, prompt_line, sid

    with ThreadPoolExecutor(max_workers=8) as pool:
        results = list(pool.map(fetch_project_data, projects))

    # --- Output ---

    ID_W = 7
    id_pre = f"{'ID':<{ID_W}}  " if show_ids else ""
    id_div = f"{'─' * ID_W}  " if show_ids else ""
    header = f"  {id_pre}{'SESSION':<{NAME_W}}  {'STATUS':<12}  {'PR':<16}  LAST ACTIVE"
    divider = f"  {id_div}{'─' * NAME_W}  {'─' * 12}  {'─' * 16}  {'─' * 11}"
    print(c(header, BOLD))
    print(c(divider, DIM))
    print()

    for cwd, branch, age, dirty, pr, notes, prompt_line, sid in results:
        proj, suf = make_label(cwd, branch)
        label_plain = proj + suf
        label_styled = c(proj, BOLD) + c(suf, DIM)
        age_str = human_age(age)

        if dirty:
            status_str = c(f"dirty ({dirty})", YELLOW)
            status_pad = f"dirty ({dirty})"
        else:
            status_str = c("clean", GREEN)
            status_pad = "clean"

        if pr.startswith("#"):
            parts = pr.split()
            state = parts[1].lower() if len(parts) >= 2 else ""
            pr_url = parts[2] if len(parts) >= 3 and parts[2].startswith("http") else ""
            pr_display = f"{parts[0]} {state}"
            pr_color = GREEN if state == "open" else (BLUE if state == "merged" else DIM)
            pr_str = c(hyperlink(pr_url, pr_display), pr_color)
            pr = pr_display  # use display text for padding calculation
        elif pr == "—":
            pr_str = ""
            pr = ""
        else:
            pr_str = c(pr, DIM)

        # Pad manually since color codes throw off f-string width
        id_col     = (c(sid, DIM) + " " * (ID_W - len(sid)) + "  ") if show_ids else ""
        label_col  = label_styled         + " " * (NAME_W - len(label_plain))
        status_col = status_str           + " " * (12 - len(status_pad))
        pr_col     = pr_str               + " " * (16 - len(pr))
        notes_pad  = (" " * ID_W + "  ") if show_ids else ""

        print(f"  {id_col}{label_col}  {status_col}  {pr_col}  {c(age_str, DIM)}")
        # Truncate prompt to fit terminal width (4 = indent + connector + space)
        if prompt_line:
            max_prompt = max(40, cols - 4 - len(notes_pad))
            truncated = prompt_line[:max_prompt - 1] + "…" if len(prompt_line) > max_prompt else prompt_line
            prompt_display = c(f"> {truncated}", DIM)
        else:
            prompt_display = ""
        sub_lines = [l for l in [prompt_display, notes] if l]
        for i, line in enumerate(sub_lines):
            connector = "└" if i == len(sub_lines) - 1 else "├"
            print(f"  {notes_pad}{c(connector, DIM)} {line}")
        if sub_lines:
            print()


def cleanup_lockfile():
    try:
        os.unlink(LOCKFILE)
    except OSError:
        pass


if watch_interval is not None:
    # Single-instance check
    try:
        with open(LOCKFILE) as f:
            old_pid = int(f.read().strip())
        try:
            os.kill(old_pid, 0)
            print(f"claude-sessions --watch is already running (pid {old_pid})", file=sys.stderr)
            sys.exit(1)
        except OSError:
            pass  # stale lockfile, proceed
    except (OSError, ValueError):
        pass

    with open(LOCKFILE, "w") as f:
        f.write(str(os.getpid()))
    atexit.register(cleanup_lockfile)

    def handle_sigint(*_):
        cleanup_lockfile()
        print()
        sys.exit(0)

    signal.signal(signal.SIGINT, handle_sigint)

    import io
    while True:
        buf = io.StringIO()
        _stdout, sys.stdout = sys.stdout, buf
        try:
            run()
        finally:
            sys.stdout = _stdout
        sys.stdout.write("\033[2J\033[H" + buf.getvalue())
        sys.stdout.flush()
        time.sleep(watch_interval)
else:
    run()
