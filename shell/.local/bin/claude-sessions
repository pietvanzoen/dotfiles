#!/usr/bin/env python3
# Show status of all active Claude Code sessions across projects.
# Usage: claude-sessions [-a|--all] [-i|--ids] [-p|--pr] [-w|--watch [SECS]] [-I|--interactive] [--age AGE] [-P|--project SUBSTR] [--prune] [--prune-merged] [--delete ID]
#   -a, --all         Show all sessions regardless of age (default: last 30 days)
#   -i, --ids         Show session IDs (for use with --delete)
#   -p, --pr          Fetch PR info from GitHub (slower — requires gh)
#   -w, --watch [N]   Live-updating dashboard, refreshing every N seconds (default: 5)
#   -I, --interactive Interactive curses-based TUI with navigation and actions
#   --age AGE         Only show sessions newer than AGE (e.g. 7d, 24h, 30m)
#   -P, --project     Only show sessions whose project name contains SUBSTR (case-insensitive)
#   --prune           Remove project dirs whose cwd no longer exists
#   --prune-merged    Remove project dirs and worktrees for merged PRs
#   --delete ID       Delete a specific session by its short ID

import atexit
import curses
import json
import locale
import os
import re
import signal
import shutil
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor

# ANSI colors — enabled when tty, FORCE_COLOR, or running inside tmux/screen
USE_COLOR = (
    sys.stdout.isatty()
    or os.environ.get("FORCE_COLOR") == "1"
    or "TMUX" in os.environ
    or os.environ.get("TERM_PROGRAM") in ("tmux", "screen")
)

def c(text, *codes):
    if not USE_COLOR:
        return text
    return f"\033[{';'.join(str(x) for x in codes)}m{text}\033[0m"

def hyperlink(url, text):
    if not USE_COLOR or not url:
        return text
    return f"\033]8;;{url}\a{text}\033]8;;\a"

DIM    = 2
BOLD   = 1
RED    = 31
YELLOW = 33
GREEN  = 32
CYAN   = 36
BLUE   = 34

PROJECTS_DIR = os.path.expanduser("~/.claude/projects")
MAX_AGE_DAYS = 30

show_all = False
show_ids = False
fetch_pr = False
prune = False
prune_merged = False
delete_id = None
watch_interval = None
interactive_mode = False
project_filter = None
max_age_seconds = MAX_AGE_DAYS * 86400


def parse_age(s):
    """Parse an age string like 7d, 24h, 30m into seconds. Returns None on failure."""
    m = re.fullmatch(r'(\d+)(d|h|m|s)?', s.strip())
    if not m:
        return None
    n = int(m.group(1))
    unit = m.group(2) or 'd'
    return n * {'d': 86400, 'h': 3600, 'm': 60, 's': 1}[unit]

args = sys.argv[1:]
i = 0
while i < len(args):
    arg = args[i]
    if arg in ("-a", "--all"):
        show_all = True
    elif arg in ("-i", "--ids"):
        show_ids = True
    elif arg in ("-p", "--pr"):
        fetch_pr = True
    elif arg in ("-I", "--interactive"):
        interactive_mode = True
    elif arg in ("-w", "--watch"):
        watch_interval = 5
        if i + 1 < len(args) and args[i + 1].isdigit():
            i += 1
            watch_interval = int(args[i])
    elif arg == "--age":
        i += 1
        if i >= len(args):
            print("--age requires a value (e.g. 7d, 24h, 30m)", file=sys.stderr)
            sys.exit(1)
        parsed = parse_age(args[i])
        if parsed is None:
            print(f"--age: invalid value '{args[i]}' (use e.g. 7d, 24h, 30m)", file=sys.stderr)
            sys.exit(1)
        max_age_seconds = parsed
    elif arg in ("-P", "--project"):
        i += 1
        if i >= len(args):
            print("-P/--project requires a substring", file=sys.stderr)
            sys.exit(1)
        project_filter = args[i].lower()
    elif arg == "--prune":
        prune = True
    elif arg == "--prune-merged":
        prune_merged = True
        show_all = True  # consider all sessions, not just recent ones
    elif arg == "--delete":
        i += 1
        if i >= len(args):
            print("--delete requires a session ID", file=sys.stderr)
            sys.exit(1)
        delete_id = args[i]
        show_all = True
    else:
        print(f"Usage: claude-sessions [-a|--all] [-i|--ids] [-p|--pr] [-w|--watch [SECS]] [-I|--interactive] [--age AGE] [-P|--project SUBSTR] [--prune] [--prune-merged] [--delete ID]", file=sys.stderr)
        sys.exit(1)
    i += 1

if sum([delete_id is not None, prune, prune_merged]) > 1:
    print("--delete, --prune, and --prune-merged are mutually exclusive", file=sys.stderr)
    sys.exit(1)
if (watch_interval is not None or interactive_mode) and (delete_id is not None or prune or prune_merged):
    print("--watch/--interactive cannot be combined with --delete, --prune, or --prune-merged", file=sys.stderr)
    sys.exit(1)

LOCKFILE = "/tmp/claude-sessions-watch.pid"

now = int(time.time())

# PR cache for --watch --pr: avoid hitting the GitHub API every cycle.
# Maps (cwd, branch) -> (fetched_at, pr_str).
# Open PRs are re-fetched after PR_CACHE_TTL seconds; merged/closed are never re-fetched.
PR_CACHE: dict = {}
PR_CACHE_TTL = 60  # seconds


def human_age(age):
    if age < 60:
        return "just now"
    elif age < 3600:
        return f"{age // 60}m ago"
    elif age < 86400:
        return f"{age // 3600}h ago"
    elif age < 172800:
        return "yesterday"
    else:
        return f"{age // 86400}d ago"


def read_notes(cwd):
    """Return (summary, prompt_line, next_line, pr_str, stage) from .claude-notes, or ('', '', '', '', '') if absent."""
    notes_path = os.path.join(cwd, ".claude-notes")
    if not os.path.isfile(notes_path):
        return "", "", "", "", ""
    try:
        with open(notes_path) as f:
            lines = [l.strip() for l in f.readlines()]
        summary = next((l for l in lines if not l.startswith(("prompt:", "pr:", "next:", "stage:"))), "")
        prompt_line = next((l[7:].strip() for l in lines if l.startswith("prompt:")), "")
        next_line = next((l[5:].strip() for l in lines if l.startswith("next:")), "")
        pr_str = next((l[3:].strip() for l in lines if l.startswith("pr:")), "")
        stage = next((l[6:].strip() for l in lines if l.startswith("stage:")), "")
        return summary, prompt_line, next_line, pr_str, stage
    except OSError:
        return "", "", "", "", ""


def pr_state_from_notes(cwd):
    """Return the PR state string from .claude-notes (e.g. 'merged'), or ''."""
    _, _prompt, _next, pr_str, _stage = read_notes(cwd)
    if pr_str:
        parts = pr_str.split()
        return parts[1].lower() if len(parts) >= 2 else ""
    return ""


def find_worktree_root(cwd):
    """Return the main repo root if cwd is a git worktree, else None."""
    try:
        # git worktree list prints the main worktree first
        out = subprocess.check_output(
            ["git", "worktree", "list", "--porcelain"],
            cwd=cwd,
            stderr=subprocess.DEVNULL,
        ).decode()
        worktrees = [
            line[9:] for line in out.splitlines() if line.startswith("worktree ")
        ]
        if len(worktrees) >= 2 and os.path.abspath(cwd) != os.path.abspath(worktrees[0]):
            return worktrees[0]
    except subprocess.SubprocessError:
        pass
    return None


def remove_worktree(cwd):
    """Remove a git worktree at cwd. Returns True on success."""
    repo_root = find_worktree_root(cwd)
    if not repo_root:
        return False
    try:
        subprocess.run(
            ["git", "worktree", "remove", "--force", cwd],
            cwd=repo_root,
            check=True,
            capture_output=True,
        )
        return True
    except subprocess.SubprocessError:
        return False


def read_session(jsonl_path):
    """Return (cwd, branch) from the last meaningful line of a jsonl file."""
    cwd = branch = ""
    try:
        with open(jsonl_path) as f:
            for raw in f:
                try:
                    d = json.loads(raw)
                    if d.get("cwd"):
                        cwd = d["cwd"]
                    if d.get("gitBranch"):
                        branch = d["gitBranch"]
                except (json.JSONDecodeError, TypeError):
                    pass
    except OSError:
        pass
    return cwd, branch


def git_dirty_count(cwd):
    try:
        out = subprocess.check_output(
            ["git", "-C", cwd, "status", "--porcelain"],
            stderr=subprocess.DEVNULL,
            timeout=5,
        )
        return len(out.splitlines())
    except (subprocess.SubprocessError, FileNotFoundError):
        return 0


def gh_pr_info(cwd, branch):
    try:
        out = subprocess.check_output(
            ["gh", "pr", "list", "--head", branch, "--state", "all",
             "--limit", "1", "--json", "number,state,url,reviews"],
            cwd=cwd,
            stderr=subprocess.DEVNULL,
            timeout=10,
        )
        items = json.loads(out)
        if items:
            item = items[0]
            approved = any(r.get("state") == "APPROVED" for r in item.get("reviews", []))
            parts = [f"#{item['number']}", item['state'].lower()]
            if approved:
                parts.append("approved")
            parts.append(item['url'])
            return " ".join(parts)
    except (subprocess.SubprocessError, FileNotFoundError, json.JSONDecodeError):
        pass
    return "—"


# Preferred and minimum widths for variable columns.
# Actual widths are computed dynamically in run() based on terminal width.
PROJECT_W_PREF, PROJECT_W_MIN = 44, 12
BRANCH_W_PREF,  BRANCH_W_MIN  = 60, 15
STAGE_W_PREF,   STAGE_W_MIN   = 32, 16
NEXT_W_PREF,    NEXT_W_MIN    = 59, 15

# Fixed overhead: 2 indent + 5×2 separators + 12 STATUS + 11 LAST ACTIVE
FIXED_W      = 35
FIXED_W_IDS  = FIXED_W + 9  # +7 ID col +2 separator

# Stage label colors
STAGE_COLORS = {
    "setup": DIM, "context": DIM,
    "planning": YELLOW,
    "dev": GREEN,
    "pr": CYAN, "review": CYAN, "human-review": CYAN,
    "cleanup": BLUE,
}

TICKET_RE = re.compile(r'^[a-z]+-\d+', re.IGNORECASE)


def collect_data():
    """Collect session data and return list of result tuples.
    Each tuple: (cwd, branch, age, dirty, pr, notes, prompt_line, next_line, sid, stage, project_dir)
    """
    global now
    now = int(time.time())

    # Map cwd -> (mtime, jsonl_path, age, branch, project_dir)
    best = {}

    for entry in os.scandir(PROJECTS_DIR):
        if not entry.is_dir():
            continue
        latest_jsonl = None
        latest_mtime = 0
        for f in os.scandir(entry.path):
            if not f.name.endswith(".jsonl"):
                continue
            mtime = int(f.stat().st_mtime)
            if mtime > latest_mtime:
                latest_mtime = mtime
                latest_jsonl = f.path

        if not latest_jsonl:
            continue

        age = now - latest_mtime
        if not show_all and age > max_age_seconds:
            continue

        cwd, branch = read_session(latest_jsonl)
        if not cwd:
            continue

        if not os.path.isdir(cwd):
            continue

        # Keep only the most recent session per cwd
        if cwd not in best or latest_mtime > best[cwd][0]:
            best[cwd] = (latest_mtime, latest_jsonl, age, branch, entry.path)

    if not best:
        return []

    # Apply project filter
    if project_filter:
        best = {cwd: v for cwd, v in best.items() if project_filter in os.path.basename(cwd).lower()}

    # Sort by mtime descending
    projects = sorted(best.items(), key=lambda x: x[1][0], reverse=True)

    # Fetch git status and (optionally) PR info in parallel
    def fetch_project_data(item):
        cwd, (mtime, jsonl, age, branch, project_dir) = item
        dirty = git_dirty_count(cwd)
        notes, prompt_line, next_line, pr, stage = read_notes(cwd)
        sid = os.path.basename(jsonl).replace(".jsonl", "")[:7]
        # --pr flag: use cache to avoid hammering the GitHub API every cycle
        if fetch_pr and branch:
            key = (cwd, branch)
            cached = PR_CACHE.get(key)
            if cached:
                fetched_at, cached_pr = cached
                cached_state = cached_pr.split()[1].lower() if len(cached_pr.split()) >= 2 else ""
                is_final = cached_state in ("merged", "closed")
                if is_final or (time.time() - fetched_at < PR_CACHE_TTL):
                    pr = cached_pr
                else:
                    pr = gh_pr_info(cwd, branch)
                    PR_CACHE[key] = (time.time(), pr)
            else:
                pr = gh_pr_info(cwd, branch)
                PR_CACHE[key] = (time.time(), pr)
        if not pr:
            pr = "—"
        return cwd, branch, age, dirty, pr, notes, prompt_line, next_line, sid, stage, project_dir

    with ThreadPoolExecutor(max_workers=8) as pool:
        results = list(pool.map(fetch_project_data, projects))

    return results


def make_label(cwd, branch):
    """Return (project, display_branch) for separate column rendering (untruncated)."""
    project = os.path.basename(cwd)
    if branch:
        m = TICKET_RE.match(branch)
        if m and m.group(0).lower() in project.lower():
            display_branch = branch[len(m.group(0)):].lstrip("-") or branch
        else:
            display_branch = branch
    else:
        display_branch = ""
    return project, display_branch


def compute_widths(cols, ids):
    """Return (project_w, branch_w, stage_w, next_w) scaled to fit cols."""
    fixed = FIXED_W_IDS if ids else FIXED_W
    available = cols - fixed
    pref = PROJECT_W_PREF + BRANCH_W_PREF + STAGE_W_PREF + NEXT_W_PREF
    mins = PROJECT_W_MIN  + BRANCH_W_MIN  + STAGE_W_MIN  + NEXT_W_MIN
    if available >= pref:
        return PROJECT_W_PREF, BRANCH_W_PREF, STAGE_W_PREF, NEXT_W_PREF
    if available <= mins:
        return PROJECT_W_MIN, BRANCH_W_MIN, STAGE_W_MIN, NEXT_W_MIN
    scale = (available - mins) / (pref - mins)
    return (
        PROJECT_W_MIN + int((PROJECT_W_PREF - PROJECT_W_MIN) * scale),
        BRANCH_W_MIN  + int((BRANCH_W_PREF  - BRANCH_W_MIN)  * scale),
        STAGE_W_MIN   + int((STAGE_W_PREF   - STAGE_W_MIN)   * scale),
        NEXT_W_MIN    + int((NEXT_W_PREF    - NEXT_W_MIN)    * scale),
    )


def run():
    """Display session data in non-interactive mode."""
    results = collect_data()

    if delete_id or prune or prune_merged:
        sys.exit(0)

    if not results:
        print("No active Claude sessions found.")
        return

    # --- Output ---

    try:
        cols = os.get_terminal_size().columns
    except OSError:
        cols = 120

    ID_W = 7
    project_w, branch_w, stage_w, next_w = compute_widths(cols, show_ids)

    id_pre = f"{'ID':<{ID_W}}  " if show_ids else ""
    id_div = f"{'─' * ID_W}  " if show_ids else ""
    header  = f"  {id_pre}{'PROJECT':<{project_w}}  {'BRANCH':<{branch_w}}  {'STATUS':<12}  {'STAGE':<{stage_w}}  {'NEXT':<{next_w}}  LAST ACTIVE"
    divider = f"  {id_div}{'─' * project_w}  {'─' * branch_w}  {'─' * 12}  {'─' * stage_w}  {'─' * next_w}  {'─' * 11}"
    print(c(header, BOLD))
    print(c(divider, DIM))
    print()

    for cwd, branch, age, dirty, pr, notes, prompt_line, next_line, sid, stage, project_dir in results:
        proj, branch_display = make_label(cwd, branch)
        if len(proj) > project_w:
            proj = proj[:project_w - 1] + "…"
        if len(branch_display) > branch_w:
            branch_display = branch_display[:branch_w - 1] + "…"
        age_str = human_age(age)

        if dirty:
            status_str = c(f"dirty ({dirty})", YELLOW)
            status_pad = f"dirty ({dirty})"
        else:
            status_str = c("clean", GREEN)
            status_pad = "clean"

        # Build combined STAGE column: "stage · #PR state [✓]"
        pr_part = ""
        pr_part_plain = ""
        if pr.startswith("#"):
            parts = pr.split()
            state = parts[1].lower() if len(parts) >= 2 else ""
            approved = "approved" in parts
            pr_url = next((p for p in parts if p.startswith("http")), "")
            pr_display = f"{parts[0]} {state}"
            if approved:
                pr_display += " ✓"
            if state == "open" and approved:
                pr_color = GREEN
            elif state == "open":
                pr_color = YELLOW
            elif state == "merged":
                pr_color = BLUE
            else:
                pr_color = DIM
            pr_part = hyperlink(pr_url, c(pr_display, pr_color))
            pr_part_plain = pr_display
        elif pr != "—":
            pr_part = c(pr, DIM)
            pr_part_plain = pr

        # Compose stage display
        stage_display = ""
        stage_plain = ""
        if stage and pr_part:
            stage_color = STAGE_COLORS.get(stage, DIM)
            stage_display = c(stage, stage_color) + c(" · ", DIM) + pr_part
            stage_plain = f"{stage} · {pr_part_plain}"
        elif stage:
            stage_color = STAGE_COLORS.get(stage, DIM)
            stage_display = c(stage, stage_color)
            stage_plain = stage
        elif pr_part:
            stage_display = pr_part
            stage_plain = pr_part_plain

        # Truncate stage column if content overflows (hyperlink must stay within column bounds)
        if len(stage_plain) > stage_w:
            truncated = stage_plain[:stage_w - 1] + "…"
            combined_color = STAGE_COLORS.get(stage, DIM) if stage else DIM
            stage_display = c(truncated, combined_color)
            stage_plain = truncated

        # Pad manually since color codes throw off f-string width
        next_plain   = (next_line[:next_w - 1] + "…" if len(next_line) > next_w else next_line)
        id_col       = (c(sid, DIM) + " " * (ID_W - len(sid)) + "  ") if show_ids else ""
        project_col  = c(proj, BOLD)             + " " * (project_w - len(proj))
        branch_col   = c(branch_display, DIM)    + " " * (branch_w - len(branch_display))
        status_col   = status_str                + " " * (12 - len(status_pad))
        stage_col    = stage_display             + " " * (stage_w - len(stage_plain))
        next_col     = c(next_plain, CYAN)       + " " * (next_w - len(next_plain))
        notes_pad    = (" " * ID_W + "  ") if show_ids else ""

        print(f"  {id_col}{project_col}  {branch_col}  {status_col}  {stage_col}  {next_col}  {c(age_str, DIM)}")
        # Truncate prompt to fit terminal width (4 = indent + connector + space)
        if prompt_line:
            try:
                cols_val = os.get_terminal_size().columns
            except OSError:
                cols_val = 120
            max_prompt = max(40, cols_val - 4 - len(notes_pad))
            truncated = prompt_line[:max_prompt - 1] + "…" if len(prompt_line) > max_prompt else prompt_line
            prompt_display = c(f"> {truncated}", DIM)
        else:
            prompt_display = ""
        sub_lines = [l for l in [prompt_display, notes] if l]
        for i, line in enumerate(sub_lines):
            connector = "└" if i == len(sub_lines) - 1 else "├"
            print(f"  {notes_pad}{c(connector, DIM)} {line}")
        if sub_lines:
            print()


def tmux_attach(cwd):
    """Attach to or create a tmux window for the given cwd."""
    name = os.path.basename(cwd)
    try:
        result = subprocess.run(
            ['tmux', 'list-windows', '-t', 'dev', '-F', '#{window_name}'],
            capture_output=True, text=True, timeout=5
        )
        existing = result.stdout.strip().splitlines()
        if name in existing:
            subprocess.run(['tmux', 'select-window', '-t', f'dev:{name}'], timeout=5)
        else:
            subprocess.run(['tmux', 'new-window', '-t', 'dev', '-c', cwd, '-n', name], timeout=5)
        subprocess.run(['tmux', 'switch-client', '-t', 'dev'], timeout=5)
        return True
    except subprocess.TimeoutExpired:
        return False
    except FileNotFoundError:
        return False


def interactive():
    """Run interactive curses-based TUI."""
    locale.setlocale(locale.LC_ALL, '')

    def ui(stdscr):
        curses.curs_set(0)
        stdscr.nodelay(True)

        # Initialize color pairs (matching ANSI colors from run())
        curses.init_pair(1, curses.COLOR_GREEN, curses.COLOR_BLACK)     # clean, dev
        curses.init_pair(2, curses.COLOR_YELLOW, curses.COLOR_BLACK)    # dirty, planning, open PR
        curses.init_pair(3, curses.COLOR_CYAN, curses.COLOR_BLACK)      # pr/review/human-review
        curses.init_pair(4, curses.COLOR_BLUE, curses.COLOR_BLACK)      # cleanup, merged
        curses.init_pair(5, curses.COLOR_WHITE, curses.COLOR_BLACK)     # bold text

        selected = 0
        scroll_offset = 0
        results = collect_data()
        deletion_prompt = None
        last_refresh = time.time()

        while True:
            try:
                rows, cols = stdscr.getmaxyx()
            except:
                continue

            # Auto-refresh if watch interval is set
            if watch_interval is not None:
                if time.time() - last_refresh >= watch_interval:
                    results = collect_data()
                    last_refresh = time.time()

            stdscr.erase()

            # Header
            header = "  PROJECT              BRANCH                   STATUS        STAGE                NEXT                        LAST ACTIVE"
            try:
                stdscr.addstr(0, 0, header[:cols], curses.A_BOLD | curses.color_pair(5))
            except curses.error:
                pass
            divider = "  " + ("─" * min(cols - 4, 200))
            try:
                stdscr.addstr(1, 0, divider[:cols])
            except curses.error:
                pass

            # Data rows with notes
            data_start = 3
            visible_rows = rows - data_start - 2  # reserve 2 for bottom bar

            # Calculate which results are visible
            current_y = data_start
            visible_indices = []

            for idx in range(len(results)):
                result = results[idx]
                cwd, branch, age, dirty, pr, notes, prompt_line, next_line, sid, stage, project_dir = result

                # Calculate how many lines this row needs (1 for main + lines for notes)
                sub_lines = []
                if prompt_line:
                    sub_lines.append(prompt_line)
                if notes:
                    sub_lines.append(notes)

                lines_needed = 1 + len(sub_lines)  # main row + sub lines
                if current_y + lines_needed > data_start + visible_rows:
                    break

                visible_indices.append(idx)
                current_y += lines_needed

            # Ensure selected is in visible range
            if visible_indices:
                if selected not in visible_indices:
                    if selected < visible_indices[0]:
                        selected = visible_indices[0]
                    else:
                        selected = visible_indices[-1]

            current_y = data_start

            for idx in visible_indices:
                result = results[idx]
                cwd, branch, age, dirty, pr, notes, prompt_line, next_line, sid, stage, project_dir = result

                proj, branch_display = make_label(cwd, branch)
                age_str = human_age(age)

                # Status color
                if dirty:
                    status_str = f"dirty ({dirty})"
                    status_color = curses.color_pair(2)
                else:
                    status_str = "clean"
                    status_color = curses.color_pair(1)

                # Stage color
                stage_color_code = STAGE_COLORS.get(stage, curses.A_DIM)
                if stage_color_code == DIM:
                    stage_color = curses.A_DIM
                elif stage_color_code == YELLOW:
                    stage_color = curses.color_pair(2)
                elif stage_color_code == GREEN:
                    stage_color = curses.color_pair(1)
                elif stage_color_code == CYAN:
                    stage_color = curses.color_pair(3)
                elif stage_color_code == BLUE:
                    stage_color = curses.color_pair(4)
                else:
                    stage_color = curses.A_DIM

                # Truncate to fit
                proj = proj[:20] if len(proj) > 20 else proj
                branch_display = branch_display[:25] if len(branch_display) > 25 else branch_display
                next_line_trunc = next_line[:27] if len(next_line) > 27 else next_line

                line = f"  {proj:<20} {branch_display:<25} {status_str:<14} {stage:<20} {next_line_trunc:<27} {age_str}"

                # Highlight selected row (subtle: just bold instead of reverse)
                attr = curses.A_BOLD if idx == selected else 0

                try:
                    stdscr.addstr(current_y, 0, line[:cols], attr | status_color if status_str else attr)
                except curses.error:
                    pass

                current_y += 1

                # Show sub-lines (prompt and notes)
                sub_lines = []
                if prompt_line:
                    sub_lines.append((f"> {prompt_line}", True))  # True = is prompt
                if notes:
                    sub_lines.append((notes, False))  # False = is notes

                for i, (line_text, is_prompt) in enumerate(sub_lines):
                    connector = "└" if i == len(sub_lines) - 1 else "├"
                    line_display = f"  {connector} {line_text[:cols-5]}"

                    attr = curses.A_BOLD | curses.A_DIM if idx == selected else curses.A_DIM

                    try:
                        stdscr.addstr(current_y, 0, line_display[:cols], attr)
                    except curses.error:
                        pass

                    current_y += 1

                # Blank line between entries
                current_y += 1

            # Bottom divider and keybindings
            bottom_y = rows - 2
            divider = "  " + ("─" * min(cols - 4, 200))
            try:
                stdscr.addstr(bottom_y, 0, divider[:cols], curses.A_DIM)
            except curses.error:
                pass

            if deletion_prompt is not None and deletion_prompt == selected and selected < len(results):
                proj_name = os.path.basename(results[selected][0])
                bottom_text = f"Delete '{proj_name}'? [y/N] "
            else:
                if watch_interval is not None:
                    bottom_text = f"↑↓ navigate   Enter attach   d delete   r refresh   q quit   [auto-refresh: {watch_interval}s]"
                else:
                    bottom_text = "↑↓ navigate   Enter attach   d delete   r refresh   q quit"

            try:
                stdscr.addstr(rows - 1, 0, bottom_text[:cols])
            except curses.error:
                pass

            stdscr.refresh()

            # Handle input with timeout for auto-refresh
            timeout_ms = 100 if watch_interval is not None else -1
            stdscr.timeout(timeout_ms)
            try:
                ch = stdscr.getch()
            except:
                ch = -1

            if ch == -1:
                continue

            # Handle deletion confirmation
            if deletion_prompt is not None and deletion_prompt == selected:
                if ch == ord('y') or ch == ord('Y'):
                    try:
                        if selected < len(results):
                            shutil.rmtree(results[selected][-1])
                            results.pop(selected)
                            deletion_prompt = None
                            if selected >= len(results) and selected > 0:
                                selected -= 1
                    except Exception:
                        deletion_prompt = None
                else:
                    deletion_prompt = None
                continue

            # Navigation and actions
            if ch == ord('q') or ch == 27:  # q or ESC
                break
            elif ch == ord('j') or ch == curses.KEY_DOWN:
                if selected < len(results) - 1:
                    selected += 1
            elif ch == ord('k') or ch == curses.KEY_UP:
                if selected > 0:
                    selected -= 1
            elif ch == 10 or ch == ord('\n'):  # Enter (10 is \n on macOS)
                if results and selected < len(results):
                    cwd = results[selected][0]
                    if not os.environ.get('TMUX'):
                        try:
                            bottom_y = rows - 1
                            error_msg = "Error: Not inside tmux — cannot attach"
                            stdscr.addstr(bottom_y, 0, error_msg[:cols], curses.A_REVERSE)
                            stdscr.refresh()
                        except curses.error:
                            pass
                        time.sleep(1)
                        continue
                    # Suspend curses and attach to tmux, then resume
                    curses.endwin()
                    tmux_attach(cwd)
                    # Resume curses after returning from tmux
                    stdscr.clear()
                    stdscr.refresh()
            elif ch == ord('d'):
                if results and selected < len(results):
                    deletion_prompt = selected
            elif ch == ord('r'):
                results = collect_data()
                selected = 0
                deletion_prompt = None
                last_refresh = time.time()

    try:
        curses.wrapper(ui)
    except KeyboardInterrupt:
        pass


def cleanup_lockfile():
    try:
        os.unlink(LOCKFILE)
    except OSError:
        pass


# Handle delete/prune/prune-merged before interactive mode
if delete_id or prune or prune_merged:
    results = collect_data()
    # Handle deletion and pruning
    for cwd, branch, age, dirty, pr, notes, prompt_line, next_line, sid, stage, project_dir in results:
        if delete_id:
            if sid.startswith(delete_id) or delete_id == sid:
                proj, branch_display = make_label(cwd, branch)
                label = proj + (f" {branch_display}" if branch_display else "")
                is_worktree = os.path.isdir(cwd) and find_worktree_root(cwd)
                print(f"  Session: {label} ({sid})")
                print(f"  Path:    {cwd}")
                if is_worktree:
                    print(f"  Worktree will also be removed")
                answer = input("\n  Delete this session? [y/N] ")
                if answer.lower() in ("y", "yes"):
                    if is_worktree:
                        if remove_worktree(cwd):
                            print(f"  Removed worktree: {cwd}")
                    print(f"  Deleted: {label} ({sid})")
                    shutil.rmtree(project_dir)
                else:
                    print("  Skipped.")
            continue

        if prune:
            if not os.path.isdir(cwd):
                print(f"Pruning: {project_dir}")
                shutil.rmtree(project_dir)
            continue

        if prune_merged:
            if not os.path.isdir(cwd):
                continue
            state = pr_state_from_notes(cwd)
            # Fall back to gh if notes don't have PR state
            if not state and branch:
                pr_str = gh_pr_info(cwd, branch)
                if pr_str and pr_str != "—":
                    state = pr_str.split()[1] if len(pr_str.split()) >= 2 else ""
            if state == "merged":
                proj, branch_display = make_label(cwd, branch)
                label = proj + (f" {branch_display}" if branch_display else "")
                if remove_worktree(cwd):
                    print(f"  Removed worktree: {cwd}")
                print(f"  Pruned: {label}")
                shutil.rmtree(project_dir)
            continue
    sys.exit(0)

if interactive_mode:
    interactive()
elif watch_interval is not None:
    # Single-instance check
    try:
        with open(LOCKFILE) as f:
            old_pid = int(f.read().strip())
        try:
            os.kill(old_pid, 0)
            print(f"claude-sessions --watch is already running (pid {old_pid})", file=sys.stderr)
            sys.exit(1)
        except OSError:
            pass  # stale lockfile, proceed
    except (OSError, ValueError):
        pass

    with open(LOCKFILE, "w") as f:
        f.write(str(os.getpid()))
    atexit.register(cleanup_lockfile)

    def handle_sigint(*_):
        cleanup_lockfile()
        print()
        sys.exit(0)

    signal.signal(signal.SIGINT, handle_sigint)

    import io
    while True:
        buf = io.StringIO()
        _stdout, sys.stdout = sys.stdout, buf
        try:
            run()
        finally:
            sys.stdout = _stdout
        sys.stdout.write("\033[2J\033[H" + buf.getvalue())
        sys.stdout.flush()
        time.sleep(watch_interval)
else:
    run()
