#!/usr/bin/env bash
# trmnl-trello-status — check status of TRMNL Trello sync
#
# Usage: trmnl-trello-status [--tail] [--errors] [--test]
#
#   --tail     Follow logs in real-time
#   --errors   Show only errors
#   --test     Trigger a manual sync now

set -euo pipefail

LOG_FILE="$HOME/.local/state/trmnl-trello-sync.log"

case "${1:-}" in
  --tail)
    echo "==> Tailing TRMNL Trello sync logs (Ctrl+C to exit)"
    tail -f "$LOG_FILE"
    ;;
  
  --errors)
    echo "==> Recent errors:"
    if grep -q "Error" "$LOG_FILE" 2>/dev/null; then
      grep -B 1 -A 2 "Error" "$LOG_FILE" | tail -20
    else
      echo "No errors found"
    fi
    ;;
  
  --test)
    echo "==> Triggering manual sync..."
    if [ -f "$HOME/.env.sh.local" ]; then
      # shellcheck disable=SC1091
      source "$HOME/.env.sh.local"
    fi
    "$HOME/.local/bin/trmnl-trello-sync"
    ;;
  
  *)
    echo "==> TRMNL Trello Sync Status"
    echo ""
    
    # Check if LaunchAgent is loaded
    if launchctl list | grep -q "trmnl-trello"; then
      echo "--> LaunchAgent is loaded and running"
    else
      echo "--> LaunchAgent is NOT loaded"
      echo "    Run: launchctl load ~/Library/LaunchAgents/piet.trmnl-trello-sync.plist"
    fi
    
    echo ""
    
    # Check if log file exists
    if [ -f "$LOG_FILE" ]; then
      echo "==> Last 10 lines of log:"
      tail -10 "$LOG_FILE"
      
      echo ""
      echo "==> Summary:"
      
      # Count recent runs
      recent_runs=$(grep -c "==> TRMNL Trello Sync" "$LOG_FILE" 2>/dev/null || true)
      echo "  Total runs recorded: $recent_runs"
      
      # Last successful run
      if grep -q "==> Success" "$LOG_FILE" 2>/dev/null; then
        success_line=$(grep -n "==> Success" "$LOG_FILE" | tail -1 | cut -d: -f1)
        raw_ts=$(head -n "$success_line" "$LOG_FILE" | grep "Started at" | tail -1 | awk '{print $NF}')
        local_ts=$(date -d "$raw_ts" "+%Y-%m-%d %H:%M %Z" 2>/dev/null || echo "$raw_ts")
        echo "  --> Last successful sync: $local_ts"

        # Only count errors after the last successful run
        error_count=$(tail -n +"$success_line" "$LOG_FILE" | grep -c "Error" 2>/dev/null || true)
      else
        error_count=$(grep -c "Error" "$LOG_FILE" 2>/dev/null || true)
      fi

      if [ "$error_count" -gt 0 ]; then
        echo "  --> Errors since last success: $error_count (run with --errors to see details)"
      else
        echo "  --> No errors since last success"
      fi
    else
      echo "✗ No log file found at $LOG_FILE"
      echo "  The sync hasn't run yet, or logs are being written elsewhere"
    fi
    
    echo ""
    echo "Options:"
    echo "  trmnl-trello-status --tail     # Follow logs in real-time"
    echo "  trmnl-trello-status --errors   # Show recent errors"
    echo "  trmnl-trello-status --test     # Run sync manually now"
    ;;
esac
