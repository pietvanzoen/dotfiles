#!/usr/bin/env bash
# Remove worktrees for branches that have been deleted, merged, or gone.
set -e

# Best-effort: refresh remote-tracking refs so "gone" detection is accurate
# even when this is run standalone (git-tidy already does its own fetch).
git fetch --prune --quiet 2>/dev/null || true

# Parse git worktree list --porcelain into (path, branch) pairs, skip main worktree
worktree_data=$(git worktree list --porcelain | awk '
  /^worktree / { path = substr($0, 10) }
  /^branch /   { branch = substr($0, 8) }
  /^$/          { if (path && branch) print path "|" branch; path=""; branch="" }
' | tail -n +2)  # skip first entry (main worktree)

if [[ -z "$worktree_data" ]]; then
  echo "==> No linked worktrees found."
  exit 0
fi

trunk=$(git trunk 2>/dev/null || echo main)

kill_tmux_window() {
  local wt_path="$1"
  command -v tmux &>/dev/null || return 0
  while IFS=' ' read -r wid ppath; do
    if [[ "$ppath" == "$wt_path"* ]]; then tmux kill-window -t "$wid" 2>/dev/null || true; fi
  done < <(tmux list-panes -s -t dev -F '#{window_id} #{pane_current_path}' 2>/dev/null | sort -u -k1,1)
}

removed_clean=0
removed_stale=0
skipped_dirty=0
while IFS='|' read -r wt_path branch_ref; do
  branch="${branch_ref#refs/heads/}"
  # Eligible if branch is deleted, merged into trunk, or its upstream is gone
  is_merged=$(git branch --merged "$trunk" | sed 's/^[*+ ]*//' | grep -qx "$branch" && echo 1 || echo 0)
  is_gone=$(git branch -lvv | grep "^ *$branch " | grep -q ": gone]" && echo 1 || echo 0)
  is_deleted=0
  git show-ref --verify --quiet "refs/heads/$branch" || is_deleted=1

  if [[ "$is_deleted" -ne 1 && "$is_merged" -ne 1 && "$is_gone" -ne 1 ]]; then
    continue
  fi

  status=$(git -C "$wt_path" status --porcelain 2>/dev/null || echo)
  codes=$(echo "$status" | awk 'NF { print $1 }' | sort -u)

  if [[ -z "$status" ]]; then
    echo "==> Removing worktree for deleted branch '$branch': $wt_path"
    git worktree remove "$wt_path" 2>/dev/null \
      || { echo "    warning: could not remove $wt_path"; continue; }
    kill_tmux_window "$wt_path"
    removed_clean=$((removed_clean + 1))
  elif [[ "$codes" == "D" ]]; then
    count=$(echo "$status" | grep -c .)
    echo "==> Removing worktree for gone/merged branch '$branch' ($count stale deleted files, no real work): $wt_path"
    git worktree remove --force "$wt_path" 2>/dev/null \
      || { echo "    warning: could not force-remove $wt_path"; continue; }
    kill_tmux_window "$wt_path"
    removed_stale=$((removed_stale + 1))
  else
    summary=$(echo "$codes" | paste -sd, -)
    echo "==> Skipping '$branch' (gone/merged but has uncommitted work: $summary): $wt_path"
    skipped_dirty=$((skipped_dirty + 1))
  fi
done <<< "$worktree_data"

git worktree prune

total_removed=$((removed_clean + removed_stale))
if [[ $total_removed -eq 0 && $skipped_dirty -eq 0 ]]; then
  echo "==> No stale worktrees to remove."
else
  echo "==> Removed $total_removed worktree(s) ($removed_clean clean, $removed_stale stale-only); skipped $skipped_dirty with uncommitted work."
fi
