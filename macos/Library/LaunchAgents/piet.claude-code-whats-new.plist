<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>piet.claude-code-whats-new</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/piet/.local/bin/claude-code-whats-new</string>
        <string>--notify</string>
        <string>--mark-seen</string>
    </array>

    <!-- Run every Monday at 09:00 AM.
         If the machine is asleep at this time, launchd runs the job
         shortly after the next wake — missed triggers are not dropped. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/piet/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/piet</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/piet/.local/state/claude-code-whats-new.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/piet/.local/state/claude-code-whats-new.log</string>
</dict>
</plist>
